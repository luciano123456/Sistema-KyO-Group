<!-- Modal insumo (lista de precios del proveedor) -->
<div class="modal fade" id="pgModalInsumo" tabindex="-1" aria-labelledby="pgModalInsumoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pg-insumo-modal">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="pgModalInsumoLabel">Nuevo insumo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="pgFormInsumo" class="row g-3" autocomplete="off">
                    <input type="hidden" id="pgInsId" value="" />
                    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="pg-insumo-prov-badge">
                            <i class="fa fa-truck me-1"></i>
                            <span id="pgInsProveedorNombre">Proveedor</span>
                        </span>
                        <small id="pgInsUltimaModif" class="text-new"></small>
                    </div>
                    <div class="col-md-3">
                        <label for="pgInsCodigo" class="form-label">Código</label>
                        <input type="text" class="form-control" id="pgInsCodigo" placeholder="Opcional" />
                    </div>
                    <div class="col-md-9">
                        <label for="pgInsDescripcion" class="form-label">Descripción (*)</label>
                        <input type="text" class="form-control" id="pgInsDescripcion" required />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-4">
                        <label for="pgInsCosto" class="form-label">Costo total (*)</label>
                        <input type="text" class="form-control" id="pgInsCosto" required />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-4">
                        <label for="pgInsCantidad" class="form-label">Cantidad (*)</label>
                        <input type="text" class="form-control" id="pgInsCantidad" value="1" required />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-4">
                        <label for="pgInsPorcDesc" class="form-label">% Descuento</label>
                        <input type="text" class="form-control" id="pgInsPorcDesc" value="0" />
                    </div>
                    <div class="col-md-4">
                        <label for="pgInsCostoUnitario" class="form-label">Costo unitario</label>
                        <input type="text" class="form-control" id="pgInsCostoUnitario" readonly />
                    </div>
                    <div class="col-12">
                        <div id="pgInsErrorCampos" class="alert alert-danger d-none">Completa los campos requeridos.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-new" id="pgBtnGuardarInsumo" onclick="pgGuardarInsumo()">
                    <i class="fa fa-check me-1"></i> Registrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal orden de compra -->
<div class="modal fade" id="pgModalOc" tabindex="-1" aria-labelledby="pgModalOcLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content pg-compra-modal">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="pgModalOcLabel">Nueva orden de compra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pgOcId" value="0" />
                <input type="hidden" id="pgOcIdEstado" value="0" />
                <input type="hidden" id="pgOcBloqueada" value="0" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="pgOcUN" class="form-label">Unidad de negocio <span class="pg-req">*</span></label>
                        <select id="pgOcUN" class="form-select">
                            <option value="">Seleccionar…</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="pgOcLocal" class="form-label">Local <span class="pg-req">*</span></label>
                        <select id="pgOcLocal" class="form-select" disabled>
                            <option value="">Seleccione UN…</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Proveedor</label>
                        <input type="text" class="form-control" id="pgOcProveedor" readonly />
                    </div>
                    <div class="col-md-4">
                        <label for="pgOcFechaEmision" class="form-label">Fecha emisión <span class="pg-req">*</span></label>
                        <input type="date" class="form-control" id="pgOcFechaEmision" required />
                    </div>
                    <div class="col-md-4">
                        <label for="pgOcFechaEntrega" class="form-label">Fecha entrega</label>
                        <input type="date" class="form-control" id="pgOcFechaEntrega" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Costo total</label>
                        <input type="text" class="form-control" id="pgOcCostoTotal" readonly />
                    </div>
                    <div class="col-12">
                        <label for="pgOcNota" class="form-label">Nota interna</label>
                        <input type="text" class="form-control" id="pgOcNota" placeholder="Opcional" />
                    </div>
                </div>

                <div id="pgOcBloqueadaAlert" class="alert alert-warning d-none">
                    <i class="fa fa-lock me-1"></i>
                    Esta orden tiene compras asociadas y no puede modificarse desde acá.
                    <a href="#" id="pgOcLinkVer" class="alert-link ms-1">Ver en módulo de órdenes</a>
                </div>

                <div id="pgOcDetalleSection">
                    <div class="pg-compra-detalle-head">
                        <h6 class="mb-0"><i class="fa fa-cubes me-1"></i> Detalle de insumos</h6>
                        <button type="button" class="btn btn-new btn-sm" id="pgBtnAddOcInsumo" onclick="pgAbrirModalOcInsumo()">
                            <i class="fa fa-plus me-1"></i> Agregar insumo
                        </button>
                    </div>
                    <div class="table-responsive pg-compra-table-wrap">
                        <table class="table table-sm pg-compra-table" id="pgOcDetalleTable">
                            <thead>
                                <tr>
                                    <th>Insumo</th>
                                    <th class="text-end">P. unitario</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-center pg-compra-actions-col"></th>
                                </tr>
                            </thead>
                            <tbody id="pgOcDetalleBody"></tbody>
                        </table>
                    </div>
                </div>

                <div id="pgOcError" class="alert alert-danger d-none mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-new" id="pgBtnGuardarOc" onclick="pgGuardarOc()">
                    <i class="fa fa-check me-1"></i> Registrar orden
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal insumo en orden de compra -->
<div class="modal fade" id="pgModalOcInsumo" tabindex="-1" aria-labelledby="pgModalOcInsumoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content pg-insumo-modal">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="pgModalOcInsumoLabel">Agregar insumo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pgOcInsIndex" value="" />
                <div class="mb-3">
                    <label for="pgOcInsSelect" class="form-label">Insumo <span class="pg-req">*</span></label>
                    <select id="pgOcInsSelect" class="form-select">
                        <option value="">Seleccionar insumo…</option>
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="pgOcInsPrecio" class="form-label">Precio unitario <span class="pg-req">*</span></label>
                        <input type="text" class="form-control" id="pgOcInsPrecio" inputmode="decimal" />
                    </div>
                    <div class="col-md-6">
                        <label for="pgOcInsCantidad" class="form-label">Cantidad <span class="pg-req">*</span></label>
                        <input type="text" class="form-control" id="pgOcInsCantidad" value="1" inputmode="decimal" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Subtotal</label>
                        <input type="text" class="form-control" id="pgOcInsSubtotal" readonly />
                    </div>
                </div>
                <div id="pgOcInsError" class="alert alert-danger d-none mt-2">Complete los campos requeridos.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-new" id="pgBtnGuardarOcInsumoLinea" onclick="pgGuardarOcInsumoLinea()">
                    <i class="fa fa-check me-1"></i> Agregar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal compra -->
<div class="modal fade" id="pgModalCompra" tabindex="-1" aria-labelledby="pgModalCompraLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content pg-compra-modal">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="pgModalCompraLabel">Nueva compra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pgCompraId" value="0" />
                <input type="hidden" id="pgCompraIdUN" value="0" />
                <input type="hidden" id="pgCompraIdLocal" value="0" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="pgCompraOc" class="form-label">Orden de compra <span class="pg-req">*</span></label>
                        <select id="pgCompraOc" class="form-select">
                            <option value="">Seleccionar OC pendiente…</option>
                        </select>
                        <small class="text-muted-cc" id="pgCompraOcHint">Solo órdenes pendientes de este proveedor</small>
                    </div>
                    <div class="col-md-3">
                        <label for="pgCompraFecha" class="form-label">Fecha <span class="pg-req">*</span></label>
                        <input type="date" class="form-control" id="pgCompraFecha" required />
                    </div>
                    <div class="col-md-3">
                        <label for="pgCompraDescuentos" class="form-label">Descuentos</label>
                        <input type="text" class="form-control pg-input-money" id="pgCompraDescuentos" value="0" inputmode="decimal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unidad de negocio</label>
                        <input type="text" class="form-control" id="pgCompraUN" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Local</label>
                        <input type="text" class="form-control" id="pgCompraLocal" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Proveedor</label>
                        <input type="text" class="form-control" id="pgCompraProveedor" readonly />
                    </div>
                    <div class="col-12">
                        <label for="pgCompraNota" class="form-label">Nota interna</label>
                        <input type="text" class="form-control" id="pgCompraNota" placeholder="Opcional" />
                    </div>
                </div>

                <div id="pgCompraSinOc" class="alert alert-info d-none">
                    <i class="fa fa-info-circle me-1"></i>
                    No hay órdenes de compra pendientes para este proveedor. Creá una desde la solapa <strong>Órdenes de compra</strong>.
                </div>

                <div id="pgCompraDetalleWrap" class="d-none">
                    <div class="pg-compra-detalle-head">
                        <h6 class="mb-0"><i class="fa fa-cubes me-1"></i> Detalle de insumos</h6>
                        <div class="pg-compra-totales">
                            <span>Subtotal: <strong id="pgCompraSubtotal">$ 0,00</strong></span>
                            <span>Total: <strong id="pgCompraTotal">$ 0,00</strong></span>
                        </div>
                    </div>
                    <div class="table-responsive pg-compra-table-wrap">
                        <table class="table table-sm pg-compra-table" id="pgCompraDetalleTable">
                            <thead>
                                <tr>
                                    <th>Insumo</th>
                                    <th class="text-center">Pedida</th>
                                    <th class="text-center">Pendiente</th>
                                    <th class="text-center">Recibida</th>
                                    <th class="text-center">Dif. cant.</th>
                                    <th class="text-end">P. lista</th>
                                    <th class="text-end">P. factura</th>
                                    <th class="text-end">Dif. precio</th>
                                    <th class="text-end">Dif. subt.</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="pgCompraDetalleBody"></tbody>
                        </table>
                    </div>
                </div>

                <div id="pgCompraError" class="alert alert-danger d-none mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-new" id="pgBtnGuardarCompra" onclick="pgGuardarCompra()">
                    <i class="fa fa-check me-1"></i> Registrar compra
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal registrar pago -->
<div class="modal fade" id="pgModalPago" tabindex="-1" aria-labelledby="pgModalPagoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content pg-pago-modal">
            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="pgModalPagoLabel">Registrar pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="pg-pago-modal-intro mb-3">
                    <i class="fa fa-info-circle me-1"></i>
                    El movimiento impactará en la solapa <strong>Cuenta corriente</strong> de este proveedor.
                </p>
                <div class="pg-pago-form-shell">
                    <form id="formPagoProveedor" class="row g-3" autocomplete="off">
                        <div class="col-md-4">
                            <label for="pgPagoFecha" class="form-label">Fecha del pago <span class="pg-req">*</span></label>
                            <input type="date" class="form-control" id="pgPagoFecha" required />
                        </div>
                        <div class="col-md-4">
                            <label for="pgPagoImporte" class="form-label">Importe <span class="pg-req">*</span></label>
                            <div class="pg-input-money-wrap">
                                <span class="pg-input-money-prefix">$</span>
                                <input type="text" class="form-control pg-input-money" id="pgPagoImporte" placeholder="0,00" required inputmode="decimal" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="pgPagoCuenta" class="form-label">Cuenta de origen <span class="pg-req">*</span></label>
                            <div class="input-group input-plus">
                                <select id="pgPagoCuenta" class="form-select" required
                                        data-s2-config-nombre="Cuentas"
                                        data-s2-config-controller="Cuentas"
                                        data-s2-config-reload="/Cuentas/Lista"
                                        data-s2-config-title="Nueva cuenta"
                                        data-s2-config-combo-nombre="Tipos de cuenta"
                                        data-s2-config-combo-controller="CuentasTipos"
                                        data-s2-config-combo-label="Tipo">
                                    <option value="">Seleccionar cuenta…</option>
                                </select>
                                <button type="button" class="btn btn-plus" title="Nueva cuenta">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <label for="pgPagoConcepto" class="form-label">Concepto <span class="pg-req">*</span></label>
                            <input type="text" class="form-control" id="pgPagoConcepto" placeholder="Ej: Transferencia, cheque, efectivo…" required list="pgPagoConceptosList" />
                            <datalist id="pgPagoConceptosList">
                                <option value="Transferencia bancaria"></option>
                                <option value="Cheque"></option>
                                <option value="Efectivo"></option>
                                <option value="Débito automático"></option>
                            </datalist>
                        </div>
                        <div class="col-md-4">
                            <label for="pgPagoNota" class="form-label">Nota interna</label>
                            <input type="text" class="form-control" id="pgPagoNota" placeholder="Opcional" />
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancelar
                </button>
                <button type="button" class="btn btn-new" id="pgBtnRegistrarPago" onclick="pgRegistrarPago()">
                    <i class="fa fa-check me-1"></i> Registrar pago
                </button>
            </div>
        </div>
    </div>
</div>

