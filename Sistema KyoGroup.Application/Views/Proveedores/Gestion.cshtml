@{
    Layout = "_LayoutModulo";
    ViewData["Title"] = "Gestión de Proveedor";
    var pgId = ViewBag.Id ?? 0;
}

@section Estilos {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/ProveedoresGestion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ProveedorAnalisisTab.css" asp-append-version="true" />
}

<div class="container-fluid page-99 pg-hub">
    <!-- Header -->
    <div class="cc-header shadow-lg rounded-4 p-4 mb-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a href="@Url.Action("Index", "Proveedores")" class="btn btn-outline-light btn-sm pg-back-link">
                <i class="fa fa-angle-left me-1"></i> Volver
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="cc-badge"><i class="fa fa-truck"></i></span>
                <div>
                    <h2 class="m-0 fw-800" id="pgTitulo">@(pgId > 0 ? "Editar Proveedor" : "Nuevo Proveedor")</h2>
                    <small class="text-muted-cc" id="pgSubtitulo">Datos, precios, órdenes de compra, cuenta corriente y compras</small>
                </div>
            </div>
            <div class="ms-auto d-flex gap-2 align-items-center flex-wrap cc-header-actions cc-header-actions--inline">
                <small id="lblUltimaModif" class="text-new me-2"></small>
                <a href="@Url.Action("Analisis", "Proveedores")" class="cc-header-link cc-header-link--analisis cc-header-link--compact d-none" id="pgBtnAnalisis">
                    <span class="cc-header-link-icon" aria-hidden="true">
                        <i class="fa fa-bar-chart"></i>
                    </span>
                    <span class="cc-header-link-text">
                        <span class="cc-header-link-title">Análisis</span>
                        <span class="cc-header-link-sub">Compras y deuda</span>
                    </span>
                    <span class="cc-header-link-chevron" aria-hidden="true">
                        <i class="fa fa-angle-right"></i>
                    </span>
                </a>
                <button type="button" class="btn btn-new" id="btnGuardarProveedor" onclick="pgGuardarProveedor()">
                    <i class="fa fa-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>

    <input type="hidden" id="pgId" value="@pgId" />

    <!-- Tabs -->
    <div class="card-glass pg-tabs-card">
        <div class="pg-resumen-row d-none" id="pgResumenRow">
            <div class="pg-kpi-mini pg-kpi-sage">
                <div class="pg-kpi-label">Insumos en lista</div>
                <div class="pg-kpi-value" id="pgKpiInsumos">—</div>
            </div>
            <div class="pg-kpi-mini">
                <div class="pg-kpi-label">Compras registradas</div>
                <div class="pg-kpi-value" id="pgKpiCompras">—</div>
            </div>
            <div class="pg-kpi-mini pg-kpi-sky">
                <div class="pg-kpi-label">Saldo cuenta corriente</div>
                <div class="pg-kpi-value" id="pgKpiSaldo">—</div>
            </div>
            <div class="pg-kpi-mini">
                <div class="pg-kpi-label">Total comprado</div>
                <div class="pg-kpi-value" id="pgKpiTotalComprado">—</div>
            </div>
            <div class="pg-kpi-mini pg-kpi-sage">
                <div class="pg-kpi-label">Últ. actualización precio</div>
                <div class="pg-kpi-value" id="pgKpiUltPrecio" style="font-size:0.9rem">—</div>
            </div>
        </div>
        <div class="pg-tabs-nav">
            <div class="pg-tabs-pills nav nav-tabs" id="pgTabs" role="tablist">
                <button class="pg-tab-pill nav-link active" id="tab-datos-btn" data-bs-toggle="tab" data-bs-target="#tab-datos" type="button" role="tab">
                    <i class="fa fa-id-card-o"></i><span>Datos</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-precios-btn" data-bs-toggle="tab" data-bs-target="#tab-precios" type="button" role="tab" data-pg-tab="precios">
                    <i class="fa fa-list-alt"></i><span>Lista de precios</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-cc-btn" data-bs-toggle="tab" data-bs-target="#tab-cc" type="button" role="tab" data-pg-tab="cc">
                    <i class="fa fa-exchange"></i><span>Cuenta corriente</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-ordenes-btn" data-bs-toggle="tab" data-bs-target="#tab-ordenes" type="button" role="tab" data-pg-tab="ordenes">
                    <i class="fa fa-shopping-basket"></i><span>Órdenes de compra</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-compras-btn" data-bs-toggle="tab" data-bs-target="#tab-compras" type="button" role="tab" data-pg-tab="compras">
                    <i class="fa fa-cart-arrow-down"></i><span>Compras</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-pagos-btn" data-bs-toggle="tab" data-bs-target="#tab-pagos" type="button" role="tab" data-pg-tab="pagos">
                    <i class="fa fa-money"></i><span>Pagos</span>
                </button>
                <button class="pg-tab-pill nav-link pg-tab-secondary" id="tab-analisis-btn" data-bs-toggle="tab" data-bs-target="#tab-analisis" type="button" role="tab" data-pg-tab="analisis">
                    <i class="fa fa-line-chart"></i><span>Análisis</span>
                </button>
            </div>
        </div>

        <div class="tab-content pg-tab-content" id="pgTabsContent">
            <!-- Datos -->
            <div class="tab-pane fade show active" id="tab-datos" role="tabpanel">
                <form id="formProveedorGestion" class="row g-3 p-3 pg-form-grid" autocomplete="off">
                    <div class="col-md-6">
                        <label for="pgNombre" class="form-label">Nombre (*)</label>
                        <input type="text" class="form-control" id="pgNombre" required />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>
                    <div class="col-md-6">
                        <label for="pgApodo" class="form-label">Apodo</label>
                        <input type="text" class="form-control" id="pgApodo" />
                    </div>
                    <div class="col-md-6">
                        <label for="pgUbicacion" class="form-label">Ubicación</label>
                        <input type="text" class="form-control" id="pgUbicacion" />
                    </div>
                    <div class="col-md-6">
                        <label for="pgTelefono" class="form-label">Teléfono</label>
                        <input type="text" class="form-control" id="pgTelefono" />
                    </div>
                    <div class="col-md-6">
                        <label for="pgCbu" class="form-label">CBU</label>
                        <input type="text" class="form-control" id="pgCbu" />
                    </div>
                    <div class="col-md-6">
                        <label for="pgCuit" class="form-label">CUIT</label>
                        <input type="text" class="form-control" id="pgCuit" />
                    </div>
                    <div class="col-12">
                        <div id="pgErrorCampos" class="alert alert-danger d-none mt-2">
                            Debes completar los campos requeridos.
                        </div>
                    </div>
                </form>
            </div>

            <!-- Lista de precios -->
            <div class="tab-pane fade" id="tab-precios" role="tabpanel">
                <div class="pg-precios-panel">
                    <div class="pg-precios-hero">
                        <div class="pg-precios-hero-icon" aria-hidden="true">
                            <i class="fa fa-tags"></i>
                        </div>
                        <div class="pg-precios-hero-text">
                            <h5 class="pg-precios-hero-title">Lista de precios</h5>
                            <p class="pg-precios-hero-sub">Gestioná insumos, costos y actualizaciones sin salir de este proveedor</p>
                        </div>
                        <div class="pg-precios-hero-actions">
                            <span class="pg-precios-count badge rounded-pill" id="pgPreciosCount">0 ítems</span>
                            <button type="button" class="btn btn-new btn-sm" onclick="pgAbrirModalInsumo()">
                                <i class="fa fa-plus me-1"></i> Agregar insumo
                            </button>
                        </div>
                    </div>

                    <div id="pgPreciosEmpty" class="pg-empty-state pg-precios-empty d-none">
                        <div class="pg-precios-empty-card">
                            <div class="pg-precios-empty-icon" aria-hidden="true">
                                <i class="fa fa-inbox"></i>
                            </div>
                            <h5>Todavía no hay insumos cargados</h5>
                            <p>Agregá el primer ítem de la lista de precios de este proveedor. Podés registrar código, descripción, costo y cantidad desde acá.</p>
                            <button type="button" class="btn btn-new" onclick="pgAbrirModalInsumo()">
                                <i class="fa fa-plus me-1"></i> Agregar primer insumo
                            </button>
                        </div>
                    </div>

                    <div class="pg-precios-table-area" id="pgPreciosTableWrap">
                        <div class="dt-dark-wrap">
                            <table class="dt-dark display compact" id="grd_PreciosProveedor" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Acciones</th>
                                        <th>Id</th>
                                        <th>Código</th>
                                        <th>Descripción</th>
                                        <th>Costo Unit.</th>
                                        <th>Cantidad</th>
                                        <th>Costo</th>
                                        <th>Actualización</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cuenta corriente -->
            <div class="tab-pane fade" id="tab-cc" role="tabpanel">
                <div class="p-3">
                    <div class="d-flex gap-3 flex-wrap mb-3 pg-kpi-row">
                        <div class="cc-stat">
                            <div class="label">Saldo anterior</div>
                            <div class="value" id="pgCcSaldoAnterior">—</div>
                        </div>
                        <div class="cc-stat">
                            <div class="label">Debe</div>
                            <div class="value" id="pgCcDebe">—</div>
                        </div>
                        <div class="cc-stat">
                            <div class="label">Haber</div>
                            <div class="value" id="pgCcHaber">—</div>
                        </div>
                        <div class="cc-stat">
                            <div class="label">Saldo actual</div>
                            <div class="value" id="pgCcSaldoActual">—</div>
                        </div>
                    </div>
                    <div class="filter-bar rounded-3 p-3 mb-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Desde</label>
                                <input type="date" id="pgCcFechaDesde" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Hasta</label>
                                <input type="date" id="pgCcFechaHasta" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tipo</label>
                                <select id="pgCcTipoMov" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="COMPRA">Compra</option>
                                    <option value="PAGO">Pago</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex gap-2">
                                <button type="button" class="btn btn-primary flex-fill" onclick="pgCargarCuentaCorriente()">
                                    <i class="fa fa-search me-1"></i> Buscar
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="dt-dark-wrap">
                        <table class="dt-dark display compact" id="grd_CcProveedor" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Concepto</th>
                                    <th>Debe</th>
                                    <th>Haber</th>
                                    <th>Saldo</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Órdenes de compra -->
            <div class="tab-pane fade" id="tab-ordenes" role="tabpanel">
                <div class="pg-ordenes-panel">
                    <div class="pg-panel-hero pg-panel-hero--ordenes">
                        <div class="pg-panel-hero-icon" aria-hidden="true">
                            <i class="fa fa-shopping-basket"></i>
                        </div>
                        <div class="pg-panel-hero-text">
                            <h5 class="pg-panel-hero-title">Órdenes de compra</h5>
                            <p class="pg-panel-hero-sub">Generá y gestioná pedidos a este proveedor</p>
                        </div>
                        <div class="pg-precios-hero-actions">
                            <span class="pg-precios-count badge rounded-pill" id="pgOrdenesCount">0 órdenes</span>
                            <button type="button" class="btn btn-new btn-sm" onclick="pgAbrirModalOc()">
                                <i class="fa fa-plus me-1"></i> Nueva orden
                            </button>
                        </div>
                    </div>

                    <div id="pgOrdenesEmpty" class="pg-empty-state pg-precios-empty d-none">
                        <div class="pg-precios-empty-card">
                            <div class="pg-precios-empty-icon" aria-hidden="true">
                                <i class="fa fa-shopping-basket"></i>
                            </div>
                            <h5>Sin órdenes de compra</h5>
                            <p>Creá la primera orden de compra para este proveedor seleccionando unidad de negocio, local e insumos.</p>
                            <button type="button" class="btn btn-new" onclick="pgAbrirModalOc()">
                                <i class="fa fa-plus me-1"></i> Nueva orden de compra
                            </button>
                        </div>
                    </div>

                    <div class="pg-precios-table-area" id="pgOrdenesTableWrap">
                        <div class="dt-dark-wrap">
                            <table class="dt-dark display compact" id="grd_OrdenesProveedor" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Acciones</th>
                                        <th>Id</th>
                                        <th>F. Emisión</th>
                                        <th>Local</th>
                                        <th>F. Entrega</th>
                                        <th>Estado</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Compras -->
            <div class="tab-pane fade" id="tab-compras" role="tabpanel">
                <div class="pg-compras-panel">
                    <div class="pg-panel-hero pg-panel-hero--compras">
                        <div class="pg-panel-hero-icon" aria-hidden="true">
                            <i class="fa fa-cart-arrow-down"></i>
                        </div>
                        <div class="pg-panel-hero-text">
                            <h5 class="pg-panel-hero-title">Compras del proveedor</h5>
                            <p class="pg-panel-hero-sub">Registrá recepciones contra órdenes de compra pendientes</p>
                        </div>
                        <div class="pg-precios-hero-actions">
                            <span class="pg-precios-count badge rounded-pill" id="pgComprasCount">0 compras</span>
                            <button type="button" class="btn btn-new btn-sm" onclick="pgAbrirModalCompra()">
                                <i class="fa fa-plus me-1"></i> Nueva compra
                            </button>
                        </div>
                    </div>

                    <div id="pgComprasEmpty" class="pg-empty-state pg-precios-empty d-none">
                        <div class="pg-precios-empty-card">
                            <div class="pg-precios-empty-icon" aria-hidden="true">
                                <i class="fa fa-shopping-cart"></i>
                            </div>
                            <h5>Sin compras registradas</h5>
                            <p>Registrá la primera compra de este proveedor seleccionando una orden de compra pendiente.</p>
                            <button type="button" class="btn btn-new" onclick="pgAbrirModalCompra()">
                                <i class="fa fa-plus me-1"></i> Registrar compra
                            </button>
                        </div>
                    </div>

                    <div class="pg-precios-table-area" id="pgComprasTableWrap">
                        <div class="dt-dark-wrap">
                            <table class="dt-dark display compact" id="grd_ComprasProveedor" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Acciones</th>
                                        <th>Id</th>
                                        <th>Fecha</th>
                                        <th>Local</th>
                                        <th>O.C.</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pagos -->
            <div class="tab-pane fade" id="tab-pagos" role="tabpanel">
                <div class="pg-pagos-panel">
                    <div class="pg-panel-hero pg-panel-hero--pago">
                        <div class="pg-panel-hero-icon" aria-hidden="true">
                            <i class="fa fa-money"></i>
                        </div>
                        <div class="pg-panel-hero-text">
                            <h5 class="pg-panel-hero-title">Pagos del proveedor</h5>
                            <p class="pg-panel-hero-sub">Historial de pagos e impacto en cuenta corriente</p>
                        </div>
                        <div class="pg-precios-hero-actions">
                            <span class="pg-precios-count badge rounded-pill" id="pgPagosCount">0 pagos</span>
                            <div class="pg-pago-saldo-chip" id="pgPagoSaldoWrap">
                                <span class="pg-pago-saldo-label">Saldo actual</span>
                                <span class="pg-pago-saldo-value" id="pgPagoSaldoActual">—</span>
                            </div>
                            <button type="button" class="btn btn-new btn-sm" onclick="pgAbrirModalPago()">
                                <i class="fa fa-plus me-1"></i> Registrar pago
                            </button>
                        </div>
                    </div>

                    <div id="pgPagosEmpty" class="pg-empty-state pg-precios-empty d-none">
                        <div class="pg-precios-empty-card">
                            <div class="pg-precios-empty-icon" aria-hidden="true">
                                <i class="fa fa-money"></i>
                            </div>
                            <h5>Sin pagos registrados</h5>
                            <p>Registrá el primer pago para impactarlo en la cuenta corriente de este proveedor.</p>
                            <button type="button" class="btn btn-new" onclick="pgAbrirModalPago()">
                                <i class="fa fa-plus me-1"></i> Registrar pago
                            </button>
                        </div>
                    </div>

                    <div class="pg-panel-body pg-pagos-list-wrap" id="pgPagosListWrap">
                        <div class="pg-pagos-list" id="pgPagosAccordion"></div>
                    </div>
                </div>
            </div>

            <!-- Análisis del proveedor -->
            <div class="tab-pane fade" id="tab-analisis" role="tabpanel">
                <div class="pg-ax-panel" id="pgAnalisisPanel">
                    <div class="pg-panel-hero pg-panel-hero--analisis">
                        <div class="pg-panel-hero-icon" aria-hidden="true">
                            <i class="fa fa-line-chart"></i>
                        </div>
                        <div class="pg-panel-hero-text">
                            <h5 class="pg-panel-hero-title">Análisis del proveedor</h5>
                            <p class="pg-panel-hero-sub">Te contamos en criollo si conviene seguirle comprando, cómo vienen los precios y qué mirar</p>
                        </div>
                        <div class="pg-precios-hero-actions">
                            <div class="pa-field mb-0">
                                <label class="form-label mb-0 small text-muted">Desde</label>
                                <input type="date" class="form-control form-control-sm" id="pgAxDesde" />
                            </div>
                            <div class="pa-field mb-0">
                                <label class="form-label mb-0 small text-muted">Hasta</label>
                                <input type="date" class="form-control form-control-sm" id="pgAxHasta" />
                            </div>
                            <button type="button" class="btn btn-new btn-sm" id="pgAxActualizar" onclick="pgCargarAnalisisProveedor(true)">
                                <i class="fa fa-refresh me-1"></i> Actualizar
                            </button>
                        </div>
                    </div>

                    <div class="pg-ax-loading d-none" id="pgAxLoading">
                        <div class="pg-ax-spinner"></div>
                        <span>Analizando proveedor…</span>
                    </div>

                    <div class="pg-ax-body" id="pgAxBody">
                        <!-- Verdict -->
                        <div class="pg-ax-verdict" id="pgAxVerdict">
                            <div class="pg-ax-score-ring" id="pgAxScoreRing">
                                <strong id="pgAxScore">—</strong>
                                <span>/100</span>
                            </div>
                            <div class="pg-ax-verdict-text">
                                <span class="pg-ax-badge" id="pgAxNivel">—</span>
                                <h4 id="pgAxTitulo">—</h4>
                                <p class="pg-ax-resumen" id="pgAxResumen">Seleccioná un rango y actualizá para leer el análisis en criollo.</p>
                                <div class="pg-ax-reco" id="pgAxRecoWrap">
                                    <div class="pg-ax-reco-label"><i class="fa fa-lightbulb-o me-1"></i> Qué te conviene hacer</div>
                                    <p id="pgAxReco">—</p>
                                </div>
                                <div class="pg-ax-cols">
                                    <div class="pg-ax-col pg-ax-col--ok">
                                        <h5><i class="fa fa-thumbs-up me-1"></i> A favor</h5>
                                        <ul id="pgAxAFavor"></ul>
                                    </div>
                                    <div class="pg-ax-col pg-ax-col--warn">
                                        <h5><i class="fa fa-exclamation-triangle me-1"></i> Ojo con esto</h5>
                                        <ul id="pgAxOjoCon"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KPIs -->
                        <div class="pg-ax-kpis" id="pgAxKpis">
                            <div class="pg-ax-kpi"><span>Le compraste</span><strong id="pgAxKpiComprado">—</strong><em>en el período</em></div>
                            <div class="pg-ax-kpi"><span>Compras hechas</span><strong id="pgAxKpiCant">—</strong><em>veces que le compraste</em></div>
                            <div class="pg-ax-kpi"><span>Ticket promedio</span><strong id="pgAxKpiTicket">—</strong><em>por compra</em></div>
                            <div class="pg-ax-kpi"><span>Saldo con él</span><strong id="pgAxKpiSaldo">—</strong><em>cuenta corriente</em></div>
                            <div class="pg-ax-kpi"><span>Productos en lista</span><strong id="pgAxKpiLista">—</strong><em>ítems que te vende</em></div>
                            <div class="pg-ax-kpi"><span>Más barato que otros</span><strong id="pgAxKpiBarato">—</strong><em>baratos / comparados</em></div>
                            <div class="pg-ax-kpi"><span>Precios que subieron</span><strong id="pgAxKpiSubas" class="pg-ax-bad">—</strong><em>en el período</em></div>
                            <div class="pg-ax-kpi"><span>Precios que bajaron</span><strong id="pgAxKpiBajas" class="pg-ax-good">—</strong><em>en el período</em></div>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-7">
                                <div class="pg-ax-card">
                                    <h6><i class="fa fa-area-chart me-1"></i> Evolución de compras</h6>
                                    <div class="pg-ax-chart"><canvas id="pgAxChartSerie"></canvas></div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="pg-ax-card">
                                    <h6><i class="fa fa-pie-chart me-1"></i> Señales del score</h6>
                                    <div class="pg-ax-chart pg-ax-chart--sm"><canvas id="pgAxChartScore"></canvas></div>
                                </div>
                            </div>
                            <div class="col-lg-6">
