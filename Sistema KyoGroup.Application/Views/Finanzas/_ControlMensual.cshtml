<div class="ts-panel">
    <div class="ts-panel-head">
        <div>
            <h2><i class="fa fa-calendar"></i>Control mensual</h2>
            <p>Compará meses y años: dónde más se gastó, el mejor neto y el pulso de cada período</p>
        </div>
        <button type="button" class="ts-btn ts-btn--ghost ts-btn--sm" id="fgCmBtnRefresh">
            <i class="fa fa-refresh"></i>Actualizar
        </button>
    </div>
    <div class="ts-panel-body">
        <div class="fg-cm-fuentes">
            <span class="fg-cm-fuentes-label" style="font-size:0.75rem;font-weight:750;color:var(--oa-muted);text-transform:uppercase">Fuentes</span>
            <button type="button" class="fg-cm-fuente is-active" data-fuente="efectivo"><i class="fa fa-money"></i> Efectivo</button>
            <button type="button" class="fg-cm-fuente is-active" data-fuente="bancos"><i class="fa fa-university"></i> Bancos</button>
            <button type="button" class="fg-cm-fuente is-active" data-fuente="gastos"><i class="fa fa-file-text-o"></i> Gastos</button>
        </div>

        <div class="row g-3 mb-2">
            <div class="col-lg-5">
                <label class="ts-form-label">Años</label>
                <div class="fg-cm-chips" id="fgCmAniosChips"></div>
            </div>
            <div class="col-lg-5">
                <label class="ts-form-label">Meses <small class="text-muted">(vacío = todos)</small></label>
                <div class="fg-cm-chips" id="fgCmMesesChips"></div>
            </div>
            <div class="col-lg-2">
                <label class="ts-form-label">Períodos</label>
                <div class="ts-kpi ts-kpi--gold" style="margin:0">
                    <div class="ts-kpi-body">
                        <span class="ts-kpi-value" id="fgCmCount">—</span>
                        <span class="ts-kpi-hint" id="fgCmFiltroResumen">—</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="fg-cm-presets">
            <span style="font-size:0.75rem;font-weight:750;color:var(--oa-muted);text-transform:uppercase">Atajos</span>
            <button type="button" class="fg-cm-preset" data-meses="1,2,3">Ene–Mar</button>
            <button type="button" class="fg-cm-preset" data-meses="4,5,6">Abr–Jun</button>
            <button type="button" class="fg-cm-preset" data-meses="7,8,9">Jul–Sep</button>
            <button type="button" class="fg-cm-preset" data-meses="10,11,12">Oct–Dic</button>
            <button type="button" class="fg-cm-preset is-active" data-meses="all">Todos los meses</button>
            <button type="button" class="fg-cm-preset" id="fgCmAniosRecientes">Últimos 3 años</button>
        </div>

        <div class="ts-kpi-grid" style="margin-top:0.6rem">
            <div class="ts-kpi ts-kpi--sage">
                <span class="ts-kpi-icon"><i class="fa fa-arrow-down"></i></span>
                <div class="ts-kpi-body">
                    <span class="ts-kpi-label">Ingresos</span>
                    <span class="ts-kpi-value" id="fgCmKpiIngresos">—</span>
                </div>
            </div>
            <div class="ts-kpi ts-kpi--rose">
                <span class="ts-kpi-icon"><i class="fa fa-arrow-up"></i></span>
                <div class="ts-kpi-body">
                    <span class="ts-kpi-label">Egresos</span>
                    <span class="ts-kpi-value" id="fgCmKpiEgresos">—</span>
                </div>
            </div>
            <div class="ts-kpi ts-kpi--amber">
                <span class="ts-kpi-icon"><i class="fa fa-file-text-o"></i></span>
                <div class="ts-kpi-body">
                    <span class="ts-kpi-label">Gastos</span>
                    <span class="ts-kpi-value" id="fgCmKpiGastos">—</span>
                </div>
            </div>
            <div class="ts-kpi ts-kpi--gold">
                <span class="ts-kpi-icon"><i class="fa fa-balance-scale"></i></span>
                <div class="ts-kpi-body">
                    <span class="ts-kpi-label">Neto del recorte</span>
                    <span class="ts-kpi-value" id="fgCmKpiNeto">—</span>
                </div>
            </div>
        </div>

        <div class="fg-cm-callouts" id="fgCmCallouts"></div>
        <div class="fg-cm-heat" id="fgCmHeat"></div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="fg-cm-table-wrap">
                    <table class="fg-cm-table">
                        <thead>
                            <tr>
                                <th>Período</th>
                                <th>Ing. efectivo</th>
                                <th>Egr. efectivo</th>
                                <th>Ing. bancos</th>
                                <th>Egr. bancos</th>
                                <th>Gastos</th>
                                <th>Neto</th>
                            </tr>
                        </thead>
                        <tbody id="fgCmBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="ts-panel h-100 mb-0">
                    <div class="ts-panel-head">
                        <div>
                            <h3><i class="fa fa-tags"></i>Categorías del mes</h3>
                            <p id="fgCmMesSelHint">Elegí un mes en la tabla o el mapa</p>
                        </div>
                    </div>
                    <div class="ts-panel-body">
                        <div class="ts-rank" id="fgCmCategorias"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
