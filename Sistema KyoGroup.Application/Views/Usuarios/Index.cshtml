@{
    ViewData["Title"] = "Usuarios";
}

@section Estilos {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Estilos base -->
    <link rel="stylesheet" href="~/css/usuarios.css" />
}

<div class="container page-99">
    <!-- Header KPI -->
    <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <span class="cc-badge"><i class="fa fa-users"></i></span>
                <div>
                    <h2 class="m-0 fw-800">Usuarios</h2>
                    <small class="text-muted-cc">Administración y acciones rápidas</small>
                </div>
            </div>
            <div class="ms-auto d-flex gap-3 flex-wrap">
                <div class="cc-stat">
                    <div class="label">Cantidad</div>
                    <div class="value" id="kpiCantUsuarios">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card-glass p-3">
                <div class="tabla-wrap position-relative">
                    <div class="tabla-contRoles-top d-flex gap-2 flex-wrap align-items-center mb-2">
                        <button class="btn btn-new d-flex align-items-center px-3 py-2 ms-auto" onclick="nuevoUsuario()">
                            <i class="fa fa-plus-square me-2"></i> Nuevo Usuario
                        </button>

                        @{
                            ViewData["ColConfigBtnId"] = "btnConfigColsG";
                            ViewData["ColConfigMenuId"] = "configColumnasMenu";
                        }
                        <partial name="~/Views/Shared/Partials/GridColumnConfigDropdown.cshtml" />
                    </div>

                    <div class="dt-dark-wrap">
                        <table class="dt-dark display nowrap compact" id="grd_Usuarios" data-dt-row-select="multi" style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Id</th>
                                    <th>Usuario</th>
                                    <th>Dónde está</th>
                                    <th>Nombre</th>
                                    <th>Apellido</th>
                                    <th>DNI</th>
                                    <th>Telefono</th>
                                    <th>Direccion</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Usuarios -->
<div class="modal fade" id="modalEdicion" tabindex="-1" aria-labelledby="modalEdicionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-edicion">
        <div class="modal-content cc-modal position-relative">
            <!-- Toast -->
          

            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="modalEdicionLabel">Editar Usuario</h5>
                <button type="button" class="btn-close custom-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

              <div id="accToast" class="acc-toast"><i class="fa fa-info-circle"></i><span id="accToastMsg">Listo.</span></div>

            <div class="modal-body">
                <!-- NAV TABS -->
                <ul class="nav nav-tabs cc-tabs mb-3" Rol="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="tab-datos" data-bs-toggle="tab" data-bs-target="#pane-datos" type="button" Rol="tab">
                            <i class="fa fa-id-card-o me-1"></i> Datos
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="tab-accesos" data-bs-toggle="tab" data-bs-target="#pane-accesos" type="button" Rol="tab">
                            <i class="fa fa-sitemap me-1"></i> Accesos
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Pesta6a: Datos -->
                    <div class="tab-pane fade show active" id="pane-datos" Rol="tabpanel" aria-labelledby="tab-datos">
                        <form id="formEditarUsuario" class="row g-3">
                            <input type="text" id="txtId" hidden readonly>

                            <!-- LÍnea 1 -->
                            <div class="col-md-4">
                                <label for="txtUsuario" class="form-label" id="lblUsuario">Usuario (*)</label>
                                <input type="text" class="form-control" id="txtUsuario" required>
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>
                            <div class="col-md-4">
                                <label for="txtNombre" class="form-label" id="lblNombre">Nombre (*)</label>
                                <input type="text" class="form-control" id="txtNombre" required>
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>
                            <div class="col-md-4">
                                <label for="txtApellido" class="form-label" id="lblApellido">Apellido</label>
                                <input type="text" class="form-control" id="txtApellido">
                            </div>

                            <!-- LÍnea 2 -->
                            <div class="col-md-4">
                                <label for="txtDni" class="form-label" id="lblDni">DNI</label>
                                <input type="text" class="form-control" id="txtDni">
                            </div>
                            <div class="col-md-4">
                                <label for="txtTelefono" class="form-label" id="lblTelefono">Teléfono</label>
                                <input type="text" class="form-control" id="txtTelefono">
                            </div>
                            <div class="col-md-4">
                                <label for="txtDireccion" class="form-label" id="lblDireccion">Dirección</label>
                                <input type="text" class="form-control" id="txtDireccion">
                            </div>

                            <!-- LÍnea 3 -->
                            <div class="col-md-4">
                                <label for="Roles" class="form-label" id="lblRol">Rol</label>
                                <select id="Roles" class="form-control">
                                    <option value="" selected>Rol</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="Estados" class="form-label" id="lblEstado">Estado</label>
                                <select id="Estados" class="form-control">
                                    <option value="" selected>Estado</option>
                                </select>
                            </div>

                            <!-- LÍnea 4 -->
                            <div class="col-md-4" id="divContrasena">
                                <label for="txtContrasena" class="form-label" id="lblContrasena">Contrase6a (*)</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="txtContrasena">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('txtContrasena')">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <div class="invalid-feedback">Campo obligatorio</div>
                            </div>

                            <div class="col-md-4" id="divContrasenaNueva">
                                <label for="txtContrasenaNueva" class="form-label" id="lblContrasenaNueva">Contrase6a Nueva</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="txtContrasenaNueva">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('txtContrasenaNueva')">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-12">
                                <div id="errorCampos" class="alert alert-danger d-none mt-2">
                                    Debes completar los campos requeridos.
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Pestaña: Accesos -->
                    <div class="tab-pane fade" id="pane-accesos" Rol="tabpanel" aria-labelledby="tab-accesos">
                        <div class="acc-shell">
                            <div class="acc-shell-head">
                                <div class="acc-shell-head-text">
                                    <h6 class="acc-shell-title"><i class="fa fa-sitemap"></i> Accesos por Unidades &amp; Locales</h6>
                                    <p class="acc-shell-sub">Elegí una unidad de negocio y marcá los locales a los que el usuario puede ingresar.</p>
                                </div>
                                <div class="acc-toolbar">
                                    <button type="button" id="btnQuitarTodo" class="acc-btn acc-btn-danger">
                                        <i class="fa fa-ban"></i> Quitar acceso a TODO
                                    </button>
                                    <button type="button" id="btnRefrescarAccesos" class="acc-btn acc-btn-ghost">
                                        <i class="fa fa-refresh"></i> Refrescar
                                    </button>
                                </div>
                            </div>

                            <div class="row g-3 acc-panels-row">
                                <div class="col-12 col-lg-5">
                                    <div class="acc-panel">
                                        <div class="acc-panel-head">
                                            <span class="acc-panel-icon acc-panel-icon--unit"><i class="fa fa-building-o"></i></span>
                                            <div>
                                                <h6 class="acc-panel-title">Unidades de Negocio</h6>
                                                <small class="acc-panel-hint">Activá el acceso con el interruptor</small>
                                            </div>
                                        </div>
                                        <div id="accUnidadesList" class="acc-units-list"></div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-7">
                                    <div class="acc-panel">
                                        <div class="acc-panel-head acc-panel-head--split" id="cardLocalesHeader">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="acc-panel-icon acc-panel-icon--local"><i class="fa fa-map-marker"></i></span>
                                                <div>
                                                    <h6 class="acc-panel-title m-0" id="accLocalesTitle">Locales</h6>
                                                    <small class="acc-panel-hint">Seleccioná los locales permitidos</small>
                                                </div>
                                            </div>
                                            <div class="acc-selectall-wrap">
                                                <input class="form-check-input" type="checkbox" id="accSelectAllLocales">
                                                <label class="acc-selectall-label" for="accSelectAllLocales">Todos los locales</label>
                                            </div>
                                        </div>
                                        <div id="accLocalesList" class="acc-locales-list"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="acc-resumen">
                                <div class="acc-resumen-head"><i class="fa fa-tags"></i> Resumen de accesos</div>
                                <div id="accResumenChips" class="acc-resumen-chips"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer modal-footer-cc">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnGuardar" class="btn btn-new" onclick="guardarCambios()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Historial de conexiones -->
<div class="modal fade" id="modalHistorialConexionesUsr" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content cc-modal usr-conn-modal">
            <div class="modal-header colorEncabezado usr-conn-modal-head">
                <div class="usr-conn-modal-titlebox">
                    <div class="usr-conn-kicker"><i class="fa fa-plug"></i> Control de acceso</div>
                    <h5 class="modal-title fw-bold mb-0" id="usrConnTitulo">Usuario</h5>
                    <p class="usr-conn-sub mb-0" id="usrConnSub">Historial de conexiones</p>
                </div>
                <button type="button" class="btn-close custom-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="usrConnKpis" class="usr-conn-kpis"></div>
                <div id="usrConnTimeline" class="usr-conn-timeline"></div>
            </div>
            <div class="modal-footer modal-footer-cc">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Utils/Modals.cshtml" />

@section Scripts {
    <partial name="~/Views/Shared/Partials/DataTablesCoreScripts.cshtml" />
    <script src="~/js/Usuarios.js?v=2.0" defer></script>
}
