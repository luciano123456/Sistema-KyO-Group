@{
    ViewBag.Title = "Nueva Receta";
}
<title>@ViewBag.Title</title>

<partial name="~/Views/Utils/Modals.cshtml" />

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/css/SubRecetasNuevoModif.css?v=3.3" rel="stylesheet" />
}

<div class="rm-page">
    <header class="rm-hero">
        <div class="rm-hero-icon"><i class="fa fa-cutlery"></i></div>
        <div class="rm-hero-text">
            <h1 id="tituloReceta" class="rm-hero-title">Nueva Receta</h1>
            <p class="rm-hero-sub">Registro y edición de recetas · composición, costos y rendimiento</p>
        </div>
        <div class="rm-hero-actions">
            <button type="button" class="rm-btn-back" onclick="window.location.href='/Recetas'">
                <i class="fa fa-angle-left"></i> Volver a Recetas
            </button>
        </div>
    </header>

    <div class="rm-cost-strip" aria-label="Resumen de costos">
        <div class="rm-cost-card">
            <span class="rm-cost-label">Costo SubRecetas</span>
            <input type="text" id="costoRecetas" class="rm-cost-input" readonly tabindex="-1" />
        </div>
        <div class="rm-cost-card">
            <span class="rm-cost-label">Costo Insumos</span>
            <input type="text" id="costoInsumos" class="rm-cost-input" readonly tabindex="-1" />
        </div>
        <div class="rm-cost-card rm-cost-card--highlight">
            <span class="rm-cost-label">Costo Porción</span>
            <input type="text" id="CostoPorcion" class="rm-cost-input" readonly tabindex="-1" />
        </div>
        <div class="rm-cost-card">
            <span class="rm-cost-label">Rendimiento</span>
            <input type="text" id="rmKpiRendimiento" class="rm-cost-input" readonly tabindex="-1" placeholder="—" />
        </div>
        <div class="rm-cost-card rm-cost-card--accent">
            <span class="rm-cost-label">Costo Unitario</span>
            <input type="text" id="CostoUnitario" class="rm-cost-input" readonly tabindex="-1" />
        </div>
    </div>

    <div class="rm-layout">
        <aside class="rm-layout-form">
            <section class="rm-panel">
                <div class="rm-panel-head">
                    <h3><i class="fa fa-info-circle"></i> Datos de la Receta</h3>
                </div>
                <div class="rm-panel-body">
                    <input type="hidden" id="idReceta" name="idReceta" />
                    <div id="frmReceta" class="rm-form-grid">
                        <div class="form-group">
                            <label class="form-label" for="UnidadesNegocio">Unidad de Negocio</label>
                            <select id="UnidadesNegocio" class="form-select" data-required="true" data-field="unidadNegocio">
                                <option value="" disabled selected>Seleccionar...</option>
                            </select>
                            <div class="invalid-feedback d-none">Campo requerido</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="sku">SKU</label>
                            <input type="text" id="sku" class="form-control" data-required="true" data-field="sku" placeholder="Código único" />
                            <div class="invalid-feedback d-none">Campo requerido</div>
                        </div>

                        <div class="form-group rm-span-full">
                            <label class="form-label" for="descripcion">Descripción</label>
                            <input type="text" id="descripcion" class="form-control" data-required="true" data-field="descripcion" placeholder="Nombre de la receta" />
                            <div class="invalid-feedback d-none">Campo requerido</div>
                        </div>

                        <div class="form-group rm-span-full">
                            <label class="form-label" for="Categorias">Categoría</label>
                            <div class="input-group input-plus">
                                <select id="Categorias" class="form-select selectAgregado" data-required="true" data-field="categoria"
                                        data-s2-config-nombre="Categorias de Recetas"
                                        data-s2-config-controller="RecetasCategoria"
                                        data-s2-config-reload="/RecetasCategoria/Lista"
                                        data-s2-config-title="Nueva categoria">
                                    <option value="" disabled selected>Seleccionar...</option>
                                </select>
                                <button type="button" class="btn btn-plus" title="Nueva categoría">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback d-none">Campo requerido</div>
                        </div>

                        <div class="form-group rm-span-full">
                            <label class="form-label" for="UnidadMedidas">Unidad de Medida</label>
                            <div class="input-group input-plus">
                                <select id="UnidadMedidas" class="form-select selectAgregado" data-required="true" data-field="unidadMedida"
                                        data-s2-config-nombre="Unidades de Medida"
                                        data-s2-config-controller="UnidadesMedida"
                                        data-s2-config-reload="/UnidadesMedida/Lista"
                                        data-s2-config-title="Nueva unidad de medida">
                                    <option value="" disabled selected>Seleccionar...</option>
                                </select>
                                <button type="button" class="btn btn-plus" title="Nueva unidad de medida">
                                    <i class="fa fa-plus"></i>
                                </button>
                            </div>
                            <div class="invalid-feedback d-none">Campo requerido</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="Rendimiento">Rendimiento</label>
                            <input type="number" id="Rendimiento" class="form-control" data-min="0.0000001" data-field="rendimiento" placeholder="Porciones" />
                            <div class="invalid-feedback d-none">Debe ser mayor que 0</div>
                        </div>
                    </div>

                    <div id="alertRequeridos" class="cc-alert-inline d-none mt-3">
                        <i class="fa fa-exclamation-triangle"></i>
                        Debes completar los campos requeridos.
                    </div>
                </div>
            </section>
        </aside>

        <div class="rm-layout-detail">
            <section class="rm-panel rm-detalle-panel">
                <div class="rm-tabs-wrap">
                    <ul class="nav nav-tabs rm-tabs" id="tabs-detalle" role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active" id="Recetas-tab" data-bs-toggle="tab" href="#Recetas" role="tab"
                               aria-controls="Recetas" aria-selected="true">
                                <i class="fa fa-sitemap"></i> SubRecetas
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link" id="insumos-tab" data-bs-toggle="tab" href="#insumos" role="tab"
                               aria-controls="insumos" aria-selected="false">
                                <i class="fa fa-cubes"></i> Insumos
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="tab-content rm-tab-content" id="tabs-detalle-content">
                    <section class="tab-pane fade show active" id="Recetas" role="tabpanel" aria-labelledby="Recetas-tab">
                        <div class="rm-table-toolbar">
                            <span class="rm-table-toolbar-title">
                                <i class="fa fa-sitemap"></i> SubRecetas de la receta
                            </span>
                            <button type="button" class="btn btn-new" onclick="anadirSubReceta()">
                                <i class="fa fa-plus"></i> Añadir
                            </button>
                        </div>
                        <div class="rm-table-wrap">
                            <table class="display nowrap table w-100" id="grd_SubRecetas" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Costo Unitario</th>
                                        <th>Cantidad</th>
                                        <th>SubTotal</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </section>

                    <section class="tab-pane fade" id="insumos" role="tabpanel" aria-labelledby="insumos-tab">
                        <div class="rm-table-toolbar">
                            <span class="rm-table-toolbar-title">
                                <i class="fa fa-cubes"></i> Insumos de la receta
                            </span>
                            <button type="button" class="btn btn-new" onclick="anadirInsumo()">
                                <i class="fa fa-plus"></i> Añadir
                            </button>
                        </div>
                        <div class="rm-table-wrap">
                            <table class="display nowrap table w-100" id="grd_Insumos" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Costo Unitario</th>
                                        <th>Cantidad</th>
                                        <th>SubTotal</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </section>
                </div>
            </section>
        </div>
    </div>

    <footer class="rm-action-bar">
        <button type="submit" id="btnNuevoModificar" class="btn btn-new" onclick="guardarCambios()">
            <i class="fa fa-save"></i> Registrar Receta
        </button>
    </footer>
</div>

<!-- MODAL: INSUMO -->
<div class="modal fade" id="insumosModal" tabindex="-1" role="dialog" aria-labelledby="insumosModalLabel" aria-hidden="true" data-editing="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content cc-modal cc-modal--elevated">
            <div class="modal-header cc-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="cc-badge"><i class="fa fa-cube"></i></span>
                    <h5 class="modal-title fw-bold m-0" id="insumosModalLabel">Seleccionar Insumo</h5>
                </div>
                <button type="button" class="btn-close custom-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formInsumo" class="cc-form-grid cc-form-2col">
                    <div class="cc-field full">
                        <label for="insumoSelect" class="form-label">Insumo</label>
                        <select id="insumoSelect" class="form-select" data-required="true">
                            <option selected disabled>Seleccionar un Insumo</option>
                        </select>
                        <div class="invalid-feedback d-none">Campo requerido</div>
                    </div>
                    <div class="cc-field">
                        <label for="precioInput" class="form-label">Precio</label>
                        <input type="text" id="precioInput" class="form-control" data-required="true" data-min="0.0000001" readonly>
                        <div class="invalid-feedback d-none">Debe ser mayor que 0</div>
                    </div>
                    <div class="cc-field">
                        <label for="cantidadInput" class="form-label">Cantidad</label>
                        <input type="number" id="cantidadInput" class="form-control" data-required="true" data-min="0.0000001">
                        <div class="invalid-feedback d-none">Debe ser mayor que 0</div>
                    </div>
                    <div class="cc-field full">
                        <label for="totalInput" class="form-label">Total</label>
                        <input type="text" id="totalInput" class="form-control" disabled>
                    </div>
                    <div id="insumoSinVinculoAlert" class="cc-alert-inline cc-alert-inline--warning d-none" style="grid-column:1/-1">
                        <i class="fa fa-link"></i>
                        <span data-rp-vinculo-msg>Este insumo no tiene proveedor vinculado con precio.</span>
                    </div>
                    <div id="modalAlertInsumo" class="cc-alert-inline d-none" style="grid-column:1/-1">
                        <i class="fa fa-exclamation-triangle"></i> Debes completar los campos obligatorios.
                    </div>
                </form>
            </div>
            <div class="modal-footer cc-modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnGuardarInsumo" class="btn btn-new" onclick="guardarInsumo()">
                    <i class="fa fa-check"></i> Añadir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: SUBRECETA -->
<div class="modal fade" id="RecetasModal" tabindex="-1" role="dialog" aria-labelledby="RecetasModalLabel" aria-hidden="true" data-editing="false">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content cc-modal cc-modal--elevated">
            <div class="modal-header cc-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="cc-badge"><i class="fa fa-sitemap"></i></span>
                    <h5 class="modal-title fw-bold m-0" id="RecetasModalLabel">Seleccionar SubReceta</h5>
                </div>
                <button type="button" class="btn-close custom-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formSubReceta" class="cc-form-grid cc-form-2col">
                    <div class="cc-field full">
                        <label for="RecetaSelect" class="form-label">SubReceta</label>
                        <select id="RecetaSelect" class="form-select" data-required="true">
                            <option selected disabled>Seleccionar una SubReceta</option>
                        </select>
                        <div class="invalid-feedback d-none">Campo requerido</div>
                    </div>
                    <div class="cc-field">
                        <label for="precioSubRecetaInput" class="form-label">Precio</label>
                        <input type="text" id="precioSubRecetaInput" class="form-control" data-required="true" data-min="0.0000001" readonly>
                        <div class="invalid-feedback d-none">Debe ser mayor que 0</div>
                    </div>
                    <div class="cc-field">
                        <label for="cantidadRecetaInput" class="form-label">Cantidad</label>
                        <input type="number" id="cantidadRecetaInput" class="form-control" data-required="true" data-min="0.0000001">
                        <div class="invalid-feedback d-none">Debe ser mayor que 0</div>
                    </div>
                    <div class="cc-field full">
                        <label for="totalRecetaInput" class="form-label">Total</label>
                        <input type="text" id="totalRecetaInput" class="form-control" disabled>
                    </div>
                    <div id="modalAlertSub" class="cc-alert-inline d-none" style="grid-column:1/-1">
                        <i class="fa fa-exclamation-triangle"></i> Debes completar los campos obligatorios.
                    </div>
                </form>
            </div>
            <div class="modal-footer cc-modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btnGuardarReceta" class="btn btn-new" onclick="guardarSubReceta()">
                    <i class="fa fa-check"></i> Añadir
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="~/Views/Shared/Partials/DataTablesCoreScripts.cshtml" />
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/locale/es.js"></script>
    <script src="~/js/cc.validators.js" asp-append-version="true"></script>
    <script src="~/js/RecetasNuevoModif.js" asp-append-version="true"></script>
}

<script>
    var RecetaData = @Html.Raw(Json.Serialize(ViewBag.Data ?? new { }));
</script>
