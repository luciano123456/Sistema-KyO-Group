<!-- Modal: lista / edición de catálogo -->
<div class="modal fade rp-modal" id="modalConfiguracion" tabindex="-1" aria-labelledby="modalConfiguracionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content rp-modal-content">
            <div class="modal-header rp-modal-header">
                <div>
                    <div class="rp-modal-title" id="modalConfiguracionLabel"><i class="fa fa-cogs"></i> Configuracion</div>
                    <div class="rp-modal-subtitle">Edita los valores disponibles</div>
                </div>
                <button type="button" class="btn-close rp-btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <label id="lblListaVacia" class="rp-empty-label" hidden></label>
                <div class="rp-search-box" id="contenedorBuscadorConfiguracion">
                    <i class="fa fa-search rp-search-icon"></i>
                    <input type="text" id="txtBuscarConfiguracion" class="rp-input rp-search-input" placeholder="Buscar configuracion..." oninput="filtrarConfiguracionesLocal(this.value)" />
                </div>
                <div class="rp-list-container" id="configuracion-list"></div>
                <div id="contenedorNombreConfiguracion" class="rp-edit-panel" hidden>
                    <label id="lblNombreConfiguracion" class="rp-label" for="txtNombreConfiguracion">Nombre</label>
                    <input type="text" class="rp-input" id="txtNombreConfiguracion" required />
                    <input type="hidden" id="txtIdConfiguracion" />
                    <div id="divConfiguracionCombo" style="margin-top:12px;" hidden>
                        <label id="lblConfiguracionCombo" class="rp-label" for="cmbConfiguracion"></label>
                        <select id="cmbConfiguracion" class="rp-input" required><option value="">Seleccione...</option></select>
                    </div>
                    <div id="divExtraField" style="margin-top:12px;" hidden>
                        <label id="lblExtraField" class="rp-label" for="txtExtraField"></label>
                        <input type="text" class="rp-input" id="txtExtraField" />
                    </div>
                    <div class="rp-edit-actions">
                        <button id="btnRegistrarModificarConfiguracion" type="button" class="rp-btn rp-btn-primary" onclick="guardarCambiosConfiguracion()"><i class="fa fa-check"></i> Guardar</button>
                        <button type="button" class="rp-btn rp-btn-secondary" onclick="cancelarModificarConfiguracion()"><i class="fa fa-times"></i> Cancelar</button>
                    </div>
                </div>
                <div class="rp-add-container">
                    <button id="agregarConfiguracion" type="button" class="rp-btn rp-btn-primary" onclick="agregarConfiguracion()"><i class="fa fa-plus"></i> Anadir</button>
                </div>
            </div>
            <div class="modal-footer rp-modal-footer d-flex justify-content-between w-100">
                <button type="button" id="btnVolverConfiguraciones" class="rp-btn rp-btn-secondary" onclick="volverConfiguraciones()"><i class="fa fa-arrow-left"></i> Volver</button>
                <button type="button" class="rp-btn rp-btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Cerrar</button>
            </div>
        </div>
    </div>
