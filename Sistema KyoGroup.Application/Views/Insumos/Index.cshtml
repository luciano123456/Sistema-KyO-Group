@{
    ViewData["Title"] = "Home Page";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="~/css/Insumos.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container page-99">
    <!-- Header tipo KPI (igual al de Gastos, adaptado) -->
    <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <span class="cc-badge"><i class="fa fa-cubes"></i></span>
                <div>
                    <h2 class="m-0 fw-800">Insumos</h2>
                    <small class="text-muted-cc">Gestión y análisis por unidad de negocio</small>
                </div>
            </div>

            <!-- KPIs -->
            <div class="ms-auto d-flex gap-3 flex-wrap">
                <div class="cc-stat"><div class="label">Cantidad</div><div class="value" id="kpiCantInsumos">0</div></div>
                <div class="cc-stat d-none d-md-block"><div class="label">Sin asociar</div><div class="value" id="kpiSinProveedor">0</div></div>
            </div>
        </div>
    </div>

    <!-- Tabla + Filtros -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card-glass p-3">
                <div class="tabla-wrap position-relative">

                    <!-- Controles top (botón Nuevo, toggle filtros, config columnas) -->
                    <div class="tabla-contRoles-top d-flex gap-2 flex-wrap align-items-center">
                        <button class="btn btn-new d-flex align-items-center px-3 py-2" onclick="nuevoInsumo()">
                            <i class="fa fa-plus-square me-2"></i> Nuevo
                        </button>

                        <!-- Toggle de filtros (estilo Gastos) -->
                        <button class="btn btn-outline-primary d-flex align-items-center" type="button" id="btnToggleFiltrosI">
                            <i class="fa fa-arrow-down me-2" id="iconFiltrosI"></i> Filtros
                        </button>

                        <partial name="~/Views/Shared/Partials/GridColumnConfigDropdown.cshtml" />
                    </div>

                    <!-- Panel de filtros -->
                    <form id="formFiltrosInsumos" class="filter-bar shadow-sm rounded-3 mb-3 p-3">

                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-4">
                                <label class="form-label">U. de Negocio</label>
                                <select id="UnidadNegocioFiltro" class="form-select">
                                    <option value="-1" selected>Todos</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-4 d-flex gap-2 mt-2 mt-md-0">
                                <button type="button" id="aplicarFiltros" class="btn btn-primary flex-fill" onclick="aplicarFiltrosInsumos()">
                                    <i class="fa fa-search me-1"></i> Buscar
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="limpiarFiltrosInsumos()">
                                    <i class="fa fa-eraser me-1"></i> Limpiar
                                </button>
                            </div>
                        </div>
                    </form>


                    <!-- DataTable -->
                    <div class="dt-dark-wrap">
                        <table class="dt-dark display nowrap compact" id="grd_Insumos" data-dt-row-select="multi" style="width:100%">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Id</th>
                                    <th>Descripcion</th>
                                    <th>Fecha Actualizacion</th>
                                    <th>Sku</th>
                                    <th>Unidad Medida</th>
                                    <th>Categoria</th>
                                    <th>Proveedor Recomendado</th>
                                    <th>Costo Unitario</th>
                                    <th>Asociado</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

               

                </div><!-- /tabla-wrap -->
            </div><!-- /card-glass -->
        </div>
    </div>
</div>

<!-- Modal Proveedores Asignados -->
<div class="modal fade" id="modalProveedoresAsignados" tabindex="-1" aria-labelledby="modalProveedoresAsignadosLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content pa-modal">
            <div class="modal-header pa-modal__header">
                <div class="pa-modal__title-wrap">
                    <span class="pa-modal__icon"><i class="fa fa-link"></i></span>
                    <div>
                        <h5 class="modal-title mb-0" id="modalProveedoresAsignadosLabel">Proveedores asignados</h5>
                        <small class="pa-modal__subtitle">Elegí ítems de lista para vincular a este insumo</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pa-modal__body">
                <div class="pa-toolbar">
                    <div class="pa-search">
                        <i class="fa fa-search"></i>
                        <input type="text" id="filtroDescripcionProveedor" placeholder="Buscar descripción…" oninput="filtrarTablaProveedor()">
                    </div>
                    <div class="pa-search">
                        <i class="fa fa-barcode"></i>
                        <input type="text" id="filtroCodigoProveedor" placeholder="Código…" oninput="filtrarTablaProveedor()">
                    </div>
                    <div class="pa-search">
                        <i class="fa fa-truck"></i>
                        <input type="text" id="filtroProveedor" placeholder="Proveedor…" oninput="filtrarTablaProveedor()">
                    </div>
                    <div class="pa-stats">
                        <span class="pa-stat" title="Visibles">
                            <i class="fa fa-eye"></i> <strong id="paVisibleCount">0</strong>
                        </span>
                        <span class="pa-stat pa-stat--ok" title="Seleccionados">
                            <i class="fa fa-check-square-o"></i> <strong id="paSelectedCount">0</strong>
                        </span>
                    </div>
                </div>

                <div class="pa-table-wrap">
                    <table class="table pa-table" id="tablaProveedoresAsignados">
                        <thead>
                            <tr>
                                <th style="width:22%">Proveedor</th>
                                <th>Descripción</th>
                                <th style="width:14%">Código</th>
                                <th style="width:12%" class="text-center">
                                    <label class="pa-check-all mb-0" title="Marcar / desmarcar visibles">
                                        <input type="checkbox" id="paCheckAllVisible" onchange="toggleAsignacionesVisibles(this.checked)">
                                        <span>Asignar</span>
                                    </label>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- contenido dinámico -->
                        </tbody>
                    </table>
                    <div id="paEmptyState" class="pa-empty d-none">
                        <i class="fa fa-search"></i>
                        <p>No hay resultados con esos filtros.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer pa-modal__footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarAsignaciones" onclick="guardarAsignacionesProveedores()">
                    <i class="fa fa-check"></i> Aplicar selección
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edición Insumo -->
<div class="modal fade" id="modalEdicion" tabindex="-1" role="dialog" aria-labelledby="modalEdicionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-edicion" role="document">
        <div class="modal-content">

            <div class="modal-header colorEncabezado">
                <h5 class="modal-title fw-bold" id="modalEdicionLabel">Nuevo Insumo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form id="formInsumo" class="row g-3">
                    <input type="text" class="input-nuevomodif" id="txtId" readonly hidden>

                      <div class="d-flex justify-content-end mt-2">
                        <small id="lblUltimaModif" class="text-new"></small>
                    </div>


                    <!-- Fila 1 -->
                    <div class="col-md-8">
                        <label id="lblDescripcion" for="txtDescripcion" class="form-label text-black">Descripcion</label>
                        <input type="text" class="form-control" id="txtDescripcion" required>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-4">
                        <label id="lblDescripcion" for="txtSku" class="form-label text-black">SKU</label>
                        <input type="text" class="form-control" id="txtSku" required>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-2">
                        <label for="UnidadesMedida" class="form-label lblDescripcion">Unidad de Medida</label>

                        <div class="input-group input-plus">
                            <select id="UnidadesMedida" class="form-select"
                                    data-s2-config-nombre="Unidades de Medida"
                                    data-s2-config-controller="UnidadesMedida"
                                    data-s2-config-reload="/UnidadesMedida/Lista"
                                    data-s2-config-title="Nueva unidad de medida">
                                <option value="-1" selected disabled>Seleccionar</option>
                            </select>
                            <button type="button" class="btn btn-plus" title="Nueva unidad">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>

                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>


                    <div class="col-md-5 position-relative">
                        <label class="form-label lblDescripcion">U. de Negocio Asociadas</label>
                        <div id="btnUnidadesNegocio" class="form-select text-truncate" style="cursor: pointer;" tabindex="0" onclick="toggleUnidadesNegocio()">
                            Seleccionar Unidades
                        </div>

                        <div id="listaUnidades" class="select-checklist shadow p-2 d-none">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="checkTodosUnidades">
                                <label class="form-check-label" for="checkTodosUnidades">Seleccionar todos</label>
                            </div>
                            <hr class="my-2" />
                        </div>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-5">
                        <label for="Categorias" class="form-label lblDescripcion">Categoria</label>

                        <div class="input-group input-plus">
                            <select id="Categorias" class="form-select"
                                    data-s2-config-nombre="Insumos Categorias"
                                    data-s2-config-controller="InsumosCategoria"
                                    data-s2-config-reload="/InsumosCategoria/Lista"
                                    data-s2-config-title="Nueva categoria">
                                <option value="-1" selected disabled>Seleccionar</option>
                            </select>

                            <button type="button" class="btn btn-plus" title="Nueva categoria">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>

                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>



                    <!-- Validación -->
                    <div id="errorCampos" class="alert alert-danger d-none">
                        Debes completar los campos obligatorios.
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-arrow-left"></i> Volver
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="abrirModalProveedoresAsignados()">
                    <i class="fa fa-link"></i> Vincular
                    <span id="badgeProveedoresAsignados" class="badge rounded-pill ms-1 d-none">0</span>
                </button>
                <button type="button" id="btnGuardar" class="btn btn-primary" onclick="guardarCambios()">
                    <i class="fa fa-check"></i> Registrar
                </button>
            </div>

        </div>
    </div>
</div>

<partial name="~/Views/Utils/Modals.cshtml" />

@section Scripts {
    <partial name="~/Views/Shared/Partials/DataTablesCoreScripts.cshtml" />
    <script src="~/js/Insumos.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/locale/es.js"></script>
}
